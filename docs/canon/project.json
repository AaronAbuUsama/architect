{
  "name": "canon",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node docs/canon/check.mjs",
        "cwd": "{workspaceRoot}"
      },
      "cache": false
    },
    "fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node docs/canon/check.mjs --fix",
        "cwd": "{workspaceRoot}"
      },
      "cache": false
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test docs/canon/quotes.test.mjs",
        "cwd": "{workspaceRoot}"
      },
      "cache": false
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node docs/canon/preview/build.mjs",
        "cwd": "{workspaceRoot}"
      },
      "cache": false
    }
  }
}
