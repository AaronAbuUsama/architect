{
  "name": "portal",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/portal/src",
  "projectType": "library",
  "tags": [
    "scope:portal",
    "env:runtime",
    "layer:2"
  ],
  "targets": {
    "lint": {},
    "typecheck": {},
    "test": {},
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p {projectRoot}/tsconfig.build.json"
      },
      "dependsOn": [
        "^build"
      ],
      "cache": true,
      "inputs": [
        "production",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/tsconfig.build.base.json"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "client": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../portal-ui/tools/pro.mjs @heroui-pro/react gate pnpm exec vite build --config vite.config.ts",
        "cwd": "{projectRoot}"
      },
      "cache": false,
      "outputs": [
        "{projectRoot}/dist/client"
      ]
    }
  }
}
