{
  "name": "@orthograph/portal-ui",
  "version": "0.0.0",
  "description": "The portal's components, built on HeroUI Pro (a peer dependency you license yourself).",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "imports": {
    "#modules/*.js": "./src/modules/*.ts"
  },
  "peerDependencies": {
    "@heroui-pro/react": ">=1.0.0-beta.11 <2.0.0"
  },
  "devDependencies": {
    "@heroui-pro/react": "1.0.0-beta.11"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "imports": {
      "#modules/*.js": "./dist/modules/*.js"
    }
  }
}
