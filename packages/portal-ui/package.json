    "motion": ">=12.23.24",
    "react": ">=19.3.1",
    "react-aria": ">=3.53.1",
    "react-aria-components": ">=1.22.1",
    "react-dom": ">=19.3.1",
    "react-stately": ">=3.51.0",
    "tailwind-merge": ">=3.4.0",
    "tailwind-variants": ">=3.3.1"
  },
  "devDependencies": {
    "@heroui-pro/react": "1.0.0-beta.11",
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "@internationalized/date": "3.12.4",
