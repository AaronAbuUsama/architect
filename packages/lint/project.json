{
  "name": "lint",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/lint/src",
  "projectType": "library",
  "tags": [
    "scope:lint",
    "env:build",
    "layer:1"
  ],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "parallel": false,
        "commands": [
          "oxlint {projectRoot}",
          "node packages/lint/scripts/baseline.ts"
        ]
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/.oxlintrc.json",
        "{workspaceRoot}/packages/*/src/**/*"
      ]
    },
    "typecheck": {},
    "test": {},
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p {projectRoot}/tsconfig.build.json"
      },
      "dependsOn": [
        "^build"
      ],
      "cache": true,
      "inputs": [
        "production",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/tsconfig.build.base.json"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "baseline": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node packages/lint/scripts/baseline.ts --shrink"
      },
      "cache": false
    }
  }
}
