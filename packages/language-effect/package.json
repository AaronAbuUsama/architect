{
  "name": "@formants/language-effect",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@formants/forman": "workspace:*",
    "@cfworker/json-schema": "4.1.4",
    "@modelcontextprotocol/sdk": "1.32.2",
    "effect": "4.1.1",
    "zod": "4.5.4"
  },
  "imports": {
    "#modules/*.js": "./src/modules/*.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "imports": {
      "#modules/*.js": "./dist/modules/*.js"
    }
  }
