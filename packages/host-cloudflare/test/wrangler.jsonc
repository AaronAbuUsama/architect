// The Worker the tests run in: real workerd, a real local D1. Nothing here reaches Cloudflare.
{
  "name": "host-cloudflare-test",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB", "database_name": "host-test", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ]
}
