{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "@portal/*": [
        "../../packages/portal/src/*"
      ],
      "@prove/*": [
        "../../packages/prove/src/*"
      ],
      "@ops/*": [
        "./src/modules/operations/*"
      ],
      "@compiler/*": [
        "../../packages/compiler/src/*"
      ]
    },
    "exactOptionalPropertyTypes": true,
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
