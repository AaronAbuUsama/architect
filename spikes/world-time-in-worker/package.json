    "better-auth": "1.7.15",
    "effect": "4.1.1",
    "jose": "6.2.15",
    "kysely": "0.29.7",
    "viem": "2.57.20"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "5.20261101.0-beta",
    "@cloudflare/workers-types": "5.20261101.1"
  }
}
