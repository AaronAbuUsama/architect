{
  "include": ["src/**/*", ".storybook/**/*"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2024"], "types": [], "target": "ES2022", "module": "ESNext",
    "moduleResolution": "bundler", "jsx": "react-jsx", "allowImportingTsExtensions": true, "noEmit": true,
    "resolveJsonModule": true, "strict": true, "skipLibCheck": true, "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true
  }
}
