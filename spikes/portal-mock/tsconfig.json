{
  "include": ["src/**/*", "vite.config.ts"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2024"], "types": ["node", "vite/client"], "target": "ES2022", "module": "ES2022",
    "moduleResolution": "bundler", "jsx": "react-jsx", "allowImportingTsExtensions": true, "noEmit": true,
    "strict": true, "skipLibCheck": true, "verbatimModuleSyntax": true
  }
}
