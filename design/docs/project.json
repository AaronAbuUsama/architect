{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "node design/docs/build.mjs", "cwd": "{workspaceRoot}" },
      "cache": false
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["node design/docs/build.mjs --check", "node design/docs/links.mjs"],
        "parallel": false,
        "cwd": "{workspaceRoot}"
      },
      "cache": false
    }
  }
}
