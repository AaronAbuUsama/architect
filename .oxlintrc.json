{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": [
    "@nx/oxlint/boundaries-plugin",
    "./packages/lint/src/main.ts"
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/generated/**",
    "spikes/**",
    "design/**",
    "tmp/**",
    "**/test/fixtures/**"
  ],
  "rules": {
    "@nx/enforce-module-boundaries": [
      "error",
      {
        "enforceBuildableLibDependency": false,
        "allow": [],
        "depConstraints": [
          {
            "sourceTag": "scope:forman",
            "onlyDependOnLibsWithTags": [],
            "allowedExternalImports": [
              "effect",
              "effect/*"
            ]
          },
          {
            "sourceTag": "env:runtime",
            "onlyDependOnLibsWithTags": [
              "env:runtime"
            ]
          },
          {
            "sourceTag": "env:build",
            "onlyDependOnLibsWithTags": [
              "env:build",
              "env:runtime"
            ]
          },
          {
            "sourceTag": "scope:project",
            "onlyDependOnLibsWithTags": [
              "scope:forman",
              "scope:language",
              "scope:host"
            ]
          }
        ],
        "allowCircularSelfDependency": true
      }
    ],
    "forman/no-old-names": "error"
  },
  "overrides": [
    {
      "files": [
        "**/*.test.ts"
      ],
      "rules": {
        "@nx/enforce-module-boundaries": [
          "error",
          {
            "enforceBuildableLibDependency": false,
            "allow": [],
            "depConstraints": [
              {
                "sourceTag": "scope:forman",
                "onlyDependOnLibsWithTags": [],
                "allowedExternalImports": [
                  "effect",
                  "effect/*",
                  "vitest"
                ]
              },
              {
                "sourceTag": "env:runtime",
                "onlyDependOnLibsWithTags": [
                  "env:runtime"
                ]
              },
              {
                "sourceTag": "env:build",
                "onlyDependOnLibsWithTags": [
                  "env:build",
                  "env:runtime"
                ]
              },
              {
                "sourceTag": "scope:project",
                "onlyDependOnLibsWithTags": [
                  "scope:forman",
                  "scope:language",
                  "scope:host"
                ]
              }
            ],
            "allowCircularSelfDependency": true
          }
        ]
      }
    },
    {
      "files": [
        "e2e/m0/names.test.ts"
      ],
      "rules": {
        "forman/no-old-names": "off"
      }
    }
  ]
}
