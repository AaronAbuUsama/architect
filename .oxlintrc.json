{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": [
    "@nx/oxlint/boundaries-plugin",
    "./packages/lint/src/main.ts"
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "design/**",
    "tmp/**",
    "**/test/fixtures/**"
  ],
  "rules": {
    "@nx/enforce-module-boundaries": [
      "error",
      {
        "enforceBuildableLibDependency": false,
        "allow": [],
        "depConstraints": [
          {
            "sourceTag": "scope:orthograph",
            "onlyDependOnLibsWithTags": [],
            "allowedExternalImports": [
              "effect",
              "effect/*"
            ]
          },
          {
            "sourceTag": "scope:portal-ui",
            "onlyDependOnLibsWithTags": [],
            "allowedExternalImports": [
              "@heroui-pro/react",
              "@heroui-pro/react/*",
              "@heroui/react",
              "effect",
              "effect/*",
              "react",
              "react/*",
              "react-dom",
              "react-dom/*"
            ]
          },
          {
            "sourceTag": "env:runtime",
            "onlyDependOnLibsWithTags": [
              "env:runtime"
            ]
          },
          {
            "sourceTag": "env:build",
            "onlyDependOnLibsWithTags": [
              "env:build",
              "env:runtime"
            ]
          },
          {
            "sourceTag": "scope:project",
            "onlyDependOnLibsWithTags": [
              "scope:orthograph",
              "scope:language",
              "scope:host",
              "scope:projections"
            ]
          },
          {
            "sourceTag": "env:support",
            "onlyDependOnLibsWithTags": [
              "env:support"
            ]
          },
          {
            "sourceTag": "env:gate",
            "onlyDependOnLibsWithTags": [
              "env:build",
              "env:runtime",
              "env:support"
            ]
          }
        ],
        "allowCircularSelfDependency": true
      }
    ],
    "ortho/no-old-names": "error",
    "ortho/no-viem-outside-chain": "error",
    "ortho/no-pro-outside-portal-ui": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "@heroui-pro/*",
              "@heroui-pro/**"
            ],
            "message": "HeroUI Pro is imported only by @orthograph/portal-ui (F7). Import the component from @orthograph/portal-ui instead."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/*.test.ts"
      ],
      "rules": {
        "@nx/enforce-module-boundaries": [
          "error",
          {
            "enforceBuildableLibDependency": false,
            "allow": [],
            "depConstraints": [
              {
                "sourceTag": "scope:orthograph",
                "onlyDependOnLibsWithTags": [],
                "allowedExternalImports": [
                  "effect",
                  "effect/*",
                  "vitest"
                ]
              },
              {
                "sourceTag": "scope:portal-ui",
                "onlyDependOnLibsWithTags": [],
                "allowedExternalImports": [
                  "@heroui-pro/react",
                  "@heroui-pro/react/*",
                  "effect",
                  "effect/*",
                  "react",
                  "react-dom/*",
                  "vitest"
                ]
              },
              {
                "sourceTag": "env:runtime",
                "onlyDependOnLibsWithTags": [
                  "env:runtime",
                  "env:support"
                ]
              },
              {
                "sourceTag": "env:build",
                "onlyDependOnLibsWithTags": [
                  "env:build",
                  "env:runtime",
                  "env:support"
                ]
              },
              {
                "sourceTag": "scope:project",
                "onlyDependOnLibsWithTags": [
                  "scope:orthograph",
                  "scope:language",
                  "scope:host",
                  "scope:projections"
                ]
              },
              {
                "sourceTag": "env:support",
                "onlyDependOnLibsWithTags": [
                  "env:support"
                ]
              },
              {
                "sourceTag": "env:gate",
                "onlyDependOnLibsWithTags": [
                  "env:build",
                  "env:runtime",
                  "env:support"
                ]
              }
            ],
            "allowCircularSelfDependency": true
          }
        ]
      }
    },
    {
      "files": [
        "e2e/m0/names.test.ts"
      ],
      "rules": {
        "ortho/no-old-names": "off"
      }
    },
    {
      "files": [
        "packages/portal-ui/**"
      ],
      "rules": {
        "ortho/no-pro-outside-portal-ui": "off",
        "no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "**/generated/**"
      ],
      "rules": {
        "@nx/enforce-module-boundaries": "off",
        "ortho/no-old-names": "off",
        "ortho/no-viem-outside-chain": "off",
        "unicorn/no-useless-spread": "off",
        "no-unused-vars": "off"
      }
    },
    {
      "files": [
        "spikes/**"
      ],
      "rules": {
        "@nx/enforce-module-boundaries": "off",
        "ortho/no-old-names": "off",
        "ortho/no-viem-outside-chain": "off",
        "ortho/no-pro-outside-portal-ui": "off",
        "no-restricted-imports": "off"
      }
    }
  ]
}
