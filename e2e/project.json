{
  "name": "e2e",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["scope:e2e", "env:gate", "layer:1"],
  "targets": {
    "lint": {
      "options": {
        "command": "oxlint {projectRoot}"
      }
    },
    "typecheck": {},
    "layer1": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --root {projectRoot} layer1" },
      "cache": false
    },
    "layer2": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --root {projectRoot} --config vitest.layer2.config.ts layer2" },
      "cache": false
    },
    "totals": {
      "executor": "nx:run-commands",
      "options": { "command": "node {projectRoot}/totals/totals.mjs" },
      "cache": false
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "node --test {projectRoot}/totals/test-totals.mjs" },
      "cache": false
    },
    "m0-names": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --root {projectRoot} --config vitest.m0.config.ts m0" },
      "cache": false
    },
    "m0": {
      "executor": "nx:run-commands",
      "options": { "parallel": false, "commands": ["nx run e2e:layer1", "nx run e2e:layer2", "nx run e2e:m0-names"] },
      "cache": false
    },
    "browser": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm exec playwright install chromium", "cwd": "{projectRoot}" },
      "cache": false
    },
    "m1-checks": {
      "dependsOn": ["browser"],
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --root {projectRoot} --config vitest.m1.config.ts m1" },
      "cache": false
    },
    "climb": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --root {projectRoot} --config vitest.climb.config.ts climb" },
      "cache": false
    },
    "climb-record": {
      "executor": "nx:run-commands",
      "options": { "command": "node tools/climb/record.mjs", "cwd": "{workspaceRoot}" },
      "cache": false
    },
    "grid-tests": {
      "dependsOn": ["browser"],
      "executor": "nx:run-commands",
      "options": { "parallel": false, "commands": ["vitest run --root {projectRoot} --config vitest.grid.config.ts grid served-portal", "node --test tools/climb/*.test.mjs"] },
      "cache": false
    },
    "grid": {
      "executor": "nx:run-commands",
      "options": { "parallel": false, "commands": ["nx run e2e:grid-tests", "tsx {projectRoot}/grid/src/main.ts run --prove"] },
      "cache": false
    },
    "ratchet-test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --root {projectRoot} --config vitest.ratchet.config.ts ratchet" },
      "cache": false
    },
    "m1-ratchet": {
      "dependsOn": ["browser"],
      "executor": "nx:run-commands",
      "options": {
        "parallel": false,
        "commands": [
          "nx run e2e:ratchet-test",
          "mkdir -p tmp && rm -f tmp/m1-report.json tmp/m1-errors.json",
          "RATCHET_ERRORS_FILE=tmp/m1-errors.json vitest run --root e2e --config vitest.m1-ratchet.config.ts m1 --reporter=default --reporter=json --reporter=./e2e/ratchet/reporter.ts --outputFile.json=../tmp/m1-report.json; node e2e/ratchet/check.ts tmp/m1-report.json e2e/m1/expected-failing tmp/m1-errors.json"
        ]
      },
      "cache": false
    },
    "stage1-ratchet": {
      "executor": "nx:run-commands",
      "options": {
        "parallel": false,
        "commands": [
          "mkdir -p tmp && rm -f tmp/stage1-report.json tmp/stage1-errors.json",
          "RATCHET_ERRORS_FILE=tmp/stage1-errors.json vitest run --root e2e --config vitest.stage1.config.ts stage1 --reporter=default --reporter=json --reporter=./e2e/ratchet/reporter.ts --outputFile.json=../tmp/stage1-report.json; node e2e/ratchet/check.ts tmp/stage1-report.json e2e/stage1/expected-failing tmp/stage1-errors.json"
        ]
      },
      "cache": false
    },
    "stage1": {
      "metadata": {
        "description": "The done check of Goal 3, begun: Plugged In's journeys in local and test. Still needs, per e2e/stage1/README.md: e2e:climb as a step, the grid cells with their logbook verdicts, the latest staging run, a snags check, the story through CLI/SDK/MCP/HTTP from ortho new, and test read from a report."
      },
      "executor": "nx:run-commands",
      "options": { "command": "nx run e2e:stage1-ratchet" },
      "cache": false
    },
    "on-chain-ratchet": {
      "executor": "nx:run-commands",
      "options": {
        "parallel": false,
        "commands": [
          "mkdir -p tmp && rm -f tmp/on-chain-report.json tmp/on-chain-errors.json",
          "RATCHET_ERRORS_FILE=tmp/on-chain-errors.json vitest run --root e2e --config vitest.on-chain.config.ts on-chain --reporter=default --reporter=json --reporter=./e2e/ratchet/reporter.ts --outputFile.json=../tmp/on-chain-report.json; node e2e/ratchet/check.ts tmp/on-chain-report.json e2e/on-chain/expected-failing tmp/on-chain-errors.json"
        ]
      },
      "cache": false
    },
    "on-chain": {
      "metadata": {
        "description": "The done check of Goal 4 (design/goals/04-on-chain.md): the ratchet over e2e/on-chain, then red while e2e/on-chain/expected-failing/ holds any file. Today it holds the budgets journeys (01) and the snag log (03); each slice's checks author adds its check as NN-<slice>.test.ts. Still needs, per e2e/on-chain/README.md: the signer of each step read from prove's report, and every slice's check."
      },
      "executor": "nx:run-commands",
      "options": { "parallel": false, "commands": ["nx run e2e:on-chain-ratchet", "node e2e/on-chain/empty-list.mjs"] },
      "cache": false
    },
    "m1": {
      "executor": "nx:run-commands",
      "options": { "command": "nx run e2e:m1-checks" },
      "cache": false
    }
  }
}
