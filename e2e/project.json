{
  "name": "e2e",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["scope:e2e", "env:gate", "layer:1"],
  "targets": {
    "lint": {},
    "typecheck": {},
    "layer1": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --root {projectRoot} layer1" },
      "cache": false
    },
    "layer2": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --root {projectRoot} --config vitest.layer2.config.ts layer2" },
      "cache": false
    },
    "m0-names": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --root {projectRoot} --config vitest.m0.config.ts m0" },
      "cache": false
    },
    "m0": {
      "executor": "nx:run-commands",
      "options": { "parallel": false, "commands": ["nx run e2e:layer1", "nx run e2e:layer2", "nx run e2e:m0-names"] },
      "cache": false
    },
    "m1-checks": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --root {projectRoot} --config vitest.m1.config.ts m1" },
      "cache": false
    },
    "climb": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --root {projectRoot} --config vitest.climb.config.ts climb" },
      "cache": false
    },
    "climb-record": {
      "executor": "nx:run-commands",
      "options": { "command": "node tools/climb/record.mjs", "cwd": "{workspaceRoot}" },
      "cache": false
    },
    "grid-tests": {
      "executor": "nx:run-commands",
      "options": { "parallel": false, "commands": ["vitest run --root {projectRoot} --config vitest.grid.config.ts grid", "node --test tools/climb/*.test.mjs"] },
      "cache": false
    },
    "grid": {
      "executor": "nx:run-commands",
      "options": { "parallel": false, "commands": ["nx run e2e:grid-tests", "tsx {projectRoot}/grid/src/main.ts run"] },
      "cache": false
    },
    "ratchet-test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --root {projectRoot} --config vitest.ratchet.config.ts ratchet" },
      "cache": false
    },
    "m1-ratchet": {
      "executor": "nx:run-commands",
      "options": {
        "parallel": false,
        "commands": [
          "nx run e2e:ratchet-test",
          "mkdir -p tmp && rm -f tmp/m1-report.json tmp/m1-errors.json",
          "RATCHET_ERRORS_FILE=tmp/m1-errors.json vitest run --root e2e --config vitest.m1-ratchet.config.ts m1 --reporter=default --reporter=json --reporter=./e2e/ratchet/reporter.ts --outputFile.json=../tmp/m1-report.json; node e2e/ratchet/check.ts tmp/m1-report.json e2e/m1/expected-failing.txt tmp/m1-errors.json"
        ]
      },
      "cache": false
    },
    "m1": {
      "executor": "nx:run-commands",
      "options": { "command": "nx run e2e:m1-checks" },
      "cache": false
    }
  }
}
