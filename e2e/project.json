{
  "name": "e2e",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["scope:e2e", "env:build", "layer:1"],
  "targets": {
    "lint": {
      "options": {
        "command": "oxlint {projectRoot} && node {projectRoot}/totals/totals.mjs --check"
      }
    },
    "typecheck": {},
    "layer1": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --root {projectRoot} layer1" },
      "cache": false
    },
    "layer2": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --root {projectRoot} --config vitest.layer2.config.ts layer2" },
      "cache": false
    },
    "totals": {
      "executor": "nx:run-commands",
      "options": { "command": "node {projectRoot}/totals/totals.mjs" },
      "cache": false
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "node --test {projectRoot}/totals/test-totals.mjs" },
      "cache": false
    },
    "m0-names": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --root {projectRoot} --config vitest.m0.config.ts m0" },
      "cache": false
    },
    "m0": {
      "executor": "nx:run-commands",
      "options": { "parallel": false, "commands": ["nx run e2e:layer1", "nx run e2e:layer2", "nx run e2e:m0-names"] },
      "cache": false
    },
    "ratchet-test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --root {projectRoot} --config vitest.ratchet.config.ts ratchet" },
      "cache": false
    },
    "m8-checks": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --root {projectRoot} --config vitest.m8.config.ts m8" },
      "cache": false
    },
    "m8-ratchet": {
      "executor": "nx:run-commands",
      "options": {
        "parallel": false,
        "commands": [
          "nx run e2e:ratchet-test",
          "mkdir -p tmp && rm -f tmp/m8-report.json tmp/m8-errors.json",
          "RATCHET_ERRORS_FILE=tmp/m8-errors.json vitest run --root e2e --config vitest.m8-ratchet.config.ts m8 --reporter=default --reporter=json --reporter=./e2e/ratchet/reporter.ts --outputFile.json=../tmp/m8-report.json; node e2e/ratchet/check.ts tmp/m8-report.json e2e/m8/expected-failing tmp/m8-errors.json"
        ]
      },
      "cache": false
    },
    "m8": {
      "executor": "nx:run-commands",
      "options": { "command": "nx run e2e:m8-checks" },
      "cache": false
    }
  }
}
